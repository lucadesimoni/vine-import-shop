{
  "name": "whitelabel-wine-shop",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": "Luca De Simoni (https://github.com/lucadesimoni)",
  "description": "Vine Import Shop — proprietary white-label B2B/B2C shop platform for wine and speciality importers",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "node server.js",
    "typecheck": "react-router typegen && tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "jobs": "tsx scripts/jobs.ts",
    "test": "vitest run",
    "e2e": "node tests/e2e/smoke.mjs",
    "smoke": "tsx scripts/smoke.ts",
    "vinx:spec": "node scripts/vinx-spec.mjs",
    "e2e:platform": "node tests/e2e/platform.mjs",
    "setup": "node scripts/setup.mjs",
    "release": "node scripts/release.mjs",
    "up": "npm ci && npm run build && npm start",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "version:bump": "node scripts/version.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "customer:new": "node scripts/customer.mjs",
    "licenses": "node scripts/licenses.mjs",
    "licenses:check": "node scripts/licenses.mjs --check",
    "changelog:check": "node scripts/check-changelog.mjs",
    "licence": "node scripts/licence.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@react-router/express": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "aws4fetch": "^1.0.20",
    "compression": "^1.8.2",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "isbot": "^5.2.3",
    "lucide-react": "^1.72.0",
    "nodemailer": "^10.5.0",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sharp": "^0.34.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/react-router": "^1.3.7",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "version": "1.14.0"
}
