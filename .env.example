# Copy to .env — every key is optional. See config/config.example.php for all options.
APP_NAME="De Simoni"
APP_URL=https://shop.example.ch
APP_DEBUG=false
CRON_KEY=change-me-long-random

DB_DRIVER=sqlite          # sqlite | mysql | pgsql
# DB_HOST=localhost
# DB_NAME=shop
# DB_USER=shop
# DB_PASS=secret

ADMIN_EMAIL=admin@example.ch
ADMIN_PASSWORD=
DEMO_DATA=true

MAIL_DRIVER=log           # log | mail | smtp
MAIL_FROM=shop@example.ch
MAIL_ADMIN=orders@example.ch
# SMTP_HOST=asmtp.mail.hostpoint.ch
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

VINX_DRIVER=mock          # mock | rest | file
VINX_BASE_URL=
VINX_AUTH=bearer
VINX_TOKEN=
VINX_WEBHOOK_SECRET=
