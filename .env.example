# ── Core ───────────────────────────────────────────────
# Postgres in production (Neon, Supabase, Infomaniak, AWS RDS, self-hosted …):
#   DATABASE_URL=postgres://user:pass@host:5432/shop
# Leave empty for embedded PGlite (zero setup, stored in ./data/db) — fine for demo/small single-server installs.
DATABASE_URL=
SESSION_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:5173

# Seed the De Simoni demo on first start of an empty database (false in production).
DEMO_DATA=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin-demo-1234

# ── Jobs (vinX sync, outbox) ───────────────────────────
# Call POST /api/cron with "Authorization: Bearer $CRON_SECRET" every 5–15 min, or run `npm run jobs`.
CRON_SECRET=change-me

# ── vinX ERP (non-secret settings are edited in Admin → Integrationen) ──
VINX_TOKEN=
VINX_PASSWORD=
VINX_WEBHOOK_SECRET=

# ── Mail ───────────────────────────────────────────────
# log | smtp
MAIL_DRIVER=log
SMTP_URL=smtps://user:pass@mail.example.ch:465
MAIL_FROM="Shop <shop@example.ch>"

# ── Payments ───────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Uploads ────────────────────────────────────────────
# local (./data/uploads) | s3 (S3-compatible: AWS, Cloudflare R2, Infomaniak Swiss Backup, Exoscale SOS …)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Optional: share login between shop and portal domains (e.g. shop.example.ch + b2b.example.ch)
# COOKIE_DOMAIN=.example.ch
