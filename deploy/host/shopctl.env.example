# /srv/shophost/shopctl.env — configuration of the shop host (chmod 600), read by shopctl (bash) and docker compose.
# Values with spaces, <, $ or other special characters go in single quotes.

# Docker image of the shop (private registry: `docker login ghcr.io` once, with a read-only token)
IMAGE=ghcr.io/lucadesimoni/vine-import-shop

# Let's Encrypt account e-mail
ACME_EMAIL=ops@example.ch

# Status page (static HTML, password protected): https://STATUS_DOMAIN
STATUS_DOMAIN=status.example.ch
STATUS_USER=ops
# bcrypt hash, set by `shopctl init` (or: docker run --rm caddy:2-alpine caddy hash-password -p '…')
STATUS_PASSWORD_HASH=

# Alerts: shop down / up again, certificate, disk, backup, update failures
ALERT_EMAIL=ops@example.ch
SMTP_URL='smtps://user:password@mail.example.ch:465'
MAIL_FROM='Shop-Host <alerts@example.ch>'
# If the whole server is down it cannot send mail itself: a free "dead man's switch" (e.g. https://healthchecks.io,
# check every 2 min, grace 10 min) mails you when the pings stop. Paste its ping URL here.
HEARTBEAT_URL=

# Automatic updates (nightly): minor = new features + fixes, patch = fixes only, off = manual (`shopctl update`)
# Major versions are never installed automatically.
UPDATE_POLICY=minor

# Backups (nightly): database + uploads + .env per shop, kept locally for BACKUP_KEEP_DAYS
BACKUP_KEEP_DAYS=14
# Off-site copy (S3 / Cloudflare R2 / Infomaniak Swiss Backup / Exoscale SOS …), encrypted with BACKUP_PASSPHRASE.
# Empty OFFSITE = local backups only. Store the passphrase in your password manager: without it nothing can be restored.
OFFSITE=
# OFFSITE=offsite:my-bucket/shops
OFFSITE_KEEP_DAYS=60
BACKUP_PASSPHRASE=
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare
RCLONE_CONFIG_OFFSITE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET=true

# Resources per shop container
SHOP_MEMORY=512m
SHOP_CPUS=1
