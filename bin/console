#!/usr/bin/env php
<?php
declare(strict_types=1);

/*
 * CLI:
 *   php bin/console install [--no-demo]   create schema (+ demo data)
 *   php bin/console vinx:ping             test ERP connection
 *   php bin/console vinx:sync [jobs]      default: outbox,stock,prices,articles  (articles:full = full import)
 *   php bin/console vinx:push             deliver queued orders/customers
 *   php bin/console user:admin EMAIL PASS create/reset an admin
 *   php bin/console serve [port]          local dev server
 *
 * Cron (every 10 min):  * /10 * * * * php /path/to/shop/bin/console vinx:sync >/dev/null 2>&1
 */

if (PHP_SAPI !== 'cli') {
    exit(1);
}

/** @var App\Core\App $app */
$app = require __DIR__ . '/../app/bootstrap.php';

$cmd = $argv[1] ?? 'help';
$out = fn (mixed $v) => print(is_string($v) ? $v . PHP_EOL : json_encode($v, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE) . PHP_EOL);

switch ($cmd) {
    case 'install':
        if ($app->db()->tableExists('settings')) {
            $out('Already installed.');
            break;
        }
        $res = App\Core\Installer::install($app, !in_array('--no-demo', $argv, true));
        $out('Installed. Admin: ' . $res['email'] . ' / ' . $res['password']);
        break;

    case 'vinx:ping':
        App\Core\Installer::ensure($app);
        try {
            $out($app->get(App\Modules\Vinx\ErpClient::class)->ping());
        } catch (Throwable $e) {
            $out('ERROR: ' . $e->getMessage());
            exit(1);
        }
        break;

    case 'vinx:sync':
        App\Core\Installer::ensure($app);
        $jobs = isset($argv[2]) ? explode(',', $argv[2]) : ['outbox', 'stock', 'prices', 'articles'];
        $out(App\Modules\Vinx\VinxModule::runScheduled($app, $jobs));
        break;

    case 'vinx:push':
        App\Core\Installer::ensure($app);
        $out(App\Modules\Vinx\VinxModule::runScheduled($app, ['outbox']));
        break;

    case 'user:admin':
        App\Core\Installer::ensure($app);
        [$email, $pass] = [$argv[2] ?? '', $argv[3] ?? ''];
        if (!filter_var($email, FILTER_VALIDATE_EMAIL) || strlen($pass) < 8) {
            $out('Usage: user:admin EMAIL PASSWORD(min 8)');
            exit(1);
        }
        $db = $app->db();
        $hash = password_hash($pass, PASSWORD_DEFAULT);
        if ($id = $db->value('SELECT id FROM users WHERE email = ?', [strtolower($email)])) {
            $db->update('users', ['password_hash' => $hash, 'role' => 'admin'], 'id = ?', [$id]);
        } else {
            $db->insert('users', ['email' => strtolower($email), 'password_hash' => $hash, 'name' => 'Admin', 'role' => 'admin', 'created_at' => App\Core\DB::now()]);
        }
        $out("Admin ready: $email");
        break;

    case 'serve':
        $port = (int) ($argv[2] ?? 8080);
        $out("Shop running at http://localhost:$port");
        passthru(sprintf('%s -S 0.0.0.0:%d -t %s %s', PHP_BINARY, $port, escapeshellarg(BASE_PATH . '/public'), escapeshellarg(BASE_PATH . '/public/index.php')));
        break;

    default:
        $out("Commands: install [--no-demo] | vinx:ping | vinx:sync [jobs] | vinx:push | user:admin EMAIL PASS | serve [port]");
}
